<odoo>
    <record id="res_groups_privilege_deduplicate" model="res.groups.privilege">
        <field name="name">Deduplication</field>
        <field name="sequence" eval="20" />
        <field
            name="category_id"
            ref="base.module_category_productivity_data_cleaning"
        />
    </record>
    <!-- Reviewers decide whether records are duplicates and which one to keep;
         managers merge and configure rules. -->
    <record id="group_deduplicate_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="sequence" eval="10" />
        <field name="privilege_id" ref="res_groups_privilege_deduplicate" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_deduplicate_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence" eval="20" />
        <field name="privilege_id" ref="res_groups_privilege_deduplicate" />
        <field name="implied_ids" eval="[(4, ref('group_deduplicate_reviewer'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
