<odoo>
    <record id="view_deduplicate_rule_list" model="ir.ui.view">
        <field name="name">deduplicate.rule.list</field>
        <field name="model">deduplicate.rule</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="res_model_id" />
                <field name="group_count" />
                <field name="require_validation" optional="show" />
                <field name="last_run" optional="show" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_deduplicate_rule_form" model="ir.ui.view">
        <field name="name">deduplicate.rule.form</field>
        <field name="model">deduplicate.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_find_duplicates"
                        type="object"
                        string="Find Duplicates"
                        class="oe_highlight"
                        invisible="not active or not line_ids"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="action_open_groups"
                            type="object"
                            icon="call_merge"
                        >
                            <field
                                name="group_count"
                                string="To Review"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Contacts by e-mail" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="res_model_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="res_model_name" invisible="1" />
                            <field name="active" invisible="1" />
                            <field
                                name="domain"
                                widget="domain"
                                options="{'model': 'res_model_name'}"
                                invisible="not res_model_id"
                            />
                        </group>
                        <group>
                            <field name="require_validation" />
                            <field
                                name="merge_action"
                                widget="radio"
                                options="{'horizontal': true}"
                            />
                            <field name="include_archived" />
                            <field
                                name="cross_company"
                                groups="base.group_multi_company"
                            />
                            <field name="last_run" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Match When" name="lines">
                            <p class="text-muted">
                                Records are grouped when every field below matches.
                                A record with an empty value on any of them is never
                                grouped.
                            </p>
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="field_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="match_mode" />
                                </list>
                            </field>
                        </page>
                        <page string="Notifications" name="notifications">
                            <group>
                                <field
                                    name="notify_user_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True}"
                                />
                                <label for="notify_frequency" string="Every" />
                                <div class="d-flex">
                                    <field
                                        name="notify_frequency"
                                        class="me-2"
                                        required="notify_user_ids"
                                    />
                                    <field
                                        name="notify_frequency_period"
                                        required="notify_user_ids"
                                    />
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_deduplicate_rule" model="ir.actions.act_window">
        <field name="name">Deduplication Rules</field>
        <field name="res_model">deduplicate.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a deduplication rule</p>
            <p>
                A rule names a model and the fields that make two of its records
                the same. Matching records are grouped for review.
            </p>
        </field>
    </record>
</odoo>
